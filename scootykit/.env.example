# ---------------------------------------------------------------
# ScootyKit environment variables
# Copy to .env.local for local development. Add the same keys in
# Vercel → Project → Settings → Environment Variables.
# ---------------------------------------------------------------

# Public site URL (used for SEO metadata, sitemap, auth redirects)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
# Publishable / anon key — safe for the browser (RLS protects data)
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key

# SERVER ONLY — never prefix with NEXT_PUBLIC_, never commit.
# Used for order creation, order tracking, rate limiting, newsletter and contact form.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-or-secret-key
